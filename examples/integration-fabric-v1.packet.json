{
  "task_id": "zeibael-integration-fabric-v1-readiness",
  "objective": "Verify ZEIBAEL best-of-specialist ownership, idempotency, retry dedupe, fail-closed adapter boundaries, zero-spend, and no-live-order invariants",
  "max_concurrency": 16,
  "planner": {
    "openclaw": {
      "role": "PLAN_COMPACTOR",
      "runtime_verified": false,
      "advisory_only": true,
      "trace_id": "fabric-v1-openclaw"
    },
    "hermes": {
      "role": "PREVALIDATOR",
      "runtime_verified": false,
      "advisory_only": true,
      "trace_id": "fabric-v1-hermes"
    }
  },
  "jobs": [
    {
      "id": "ownership_guard",
      "type": "inline",
      "code": "const p=[['supabase','CANONICAL'],['convex','REALTIME_PROJECTION'],['redis','CACHE'],['qstash','DELIVERY'],['cloudflare','SCHEDULER']];const c=p.filter(x=>x[1]==='CANONICAL');if(c.length!==1||c[0][0]!=='supabase')throw new Error('canonical_owner_invalid');return {canonical:'supabase',scheduler:'cloudflare',realtime:'convex',cache:'redis',delivery:'qstash'}"
    },
    {
      "id": "envelope_guard",
      "type": "inline",
      "code": "const required=['schema_version','event_id','trace_id','task_id','source','destination','event_type','timestamp','idempotency_key','status','payload'];const event={schema_version:'zeibael.integration-fabric.v1',event_id:'e1',trace_id:'t1',task_id:'task1',source:'blitz',destination:'fabric',event_type:'verify',timestamp:new Date(0).toISOString(),idempotency_key:'task1:v1',status:'READY',payload:{}};const missing=required.filter(k=>!(k in event));if(missing.length)throw new Error('missing:'+missing.join(','));return {required_fields:required.length,missing:0}"
    },
    {
      "id": "envelope_guard_duplicate",
      "type": "inline",
      "code": "const required=['schema_version','event_id','trace_id','task_id','source','destination','event_type','timestamp','idempotency_key','status','payload'];const event={schema_version:'zeibael.integration-fabric.v1',event_id:'e1',trace_id:'t1',task_id:'task1',source:'blitz',destination:'fabric',event_type:'verify',timestamp:new Date(0).toISOString(),idempotency_key:'task1:v1',status:'READY',payload:{}};const missing=required.filter(k=>!(k in event));if(missing.length)throw new Error('missing:'+missing.join(','));return {required_fields:required.length,missing:0}"
    },
    {
      "id": "idempotency_guard",
      "type": "inline",
      "code": "const deliveries=[{key:'job:42:v1',attempt:1},{key:'job:42:v1',attempt:2},{key:'job:43:v1',attempt:1}];const canonicalWrites=new Map();for(const d of deliveries){if(!canonicalWrites.has(d.key))canonicalWrites.set(d.key,d)}if(canonicalWrites.size!==2)throw new Error('dedupe_failed');return {deliveries:3,canonical_writes:2,duplicate_writes:0}"
    },
    {
      "id": "role_overlap_guard",
      "type": "inline",
      "code": "const roles={supabase:['canonical'],convex:['presence','heartbeat','task_coordination'],redis:['cache','dedupe','rate_limit'],qstash:['delivery','retry'],cloudflare:['scheduler']};if(roles.redis.some(x=>['presence','heartbeat','task_coordination','scheduler','canonical'].includes(x)))throw new Error('redis_overlap');if(roles.qstash.includes('scheduler'))throw new Error('qstash_scheduler_overlap');return {overlap:false,roles}"
    },
    {
      "id": "adapter_drift_guard",
      "type": "inline",
      "code": "const adapter={versioned:true,compatibility_probe:true,schema_drift:'FAIL_CLOSED',normalize_envelope:true};if(!adapter.versioned||!adapter.compatibility_probe||adapter.schema_drift!=='FAIL_CLOSED'||!adapter.normalize_envelope)throw new Error('adapter_policy_invalid');return adapter"
    },
    {
      "id": "safety_guard",
      "type": "inline",
      "code": "const policy={zero_spend_only:true,paid_fallback_allowed:false,live_order_enabled:false,supabase_cleanup_before_canary:false};if(!policy.zero_spend_only||policy.paid_fallback_allowed||policy.live_order_enabled||policy.supabase_cleanup_before_canary)throw new Error('safety_policy_invalid');return policy"
    },
    {
      "id": "final",
      "type": "inline",
      "depends_on": [
        "ownership_guard",
        "envelope_guard_duplicate",
        "idempotency_guard",
        "role_overlap_guard",
        "adapter_drift_guard",
        "safety_guard"
      ],
      "code": "return {ok:true,status:'FABRIC_V1_READINESS_GUARDS_PASS',canonical:'supabase',primary_verifier:'stackblitz-webcontainer',live_order_enabled:false}"
    }
  ]
}
